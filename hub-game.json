{
  "hubApi": 1,
  "id": "hitrun",
  "name": "Hit and Run",
  "url": "./",
  "pitch": "Army battles in the fog of war. Last army standing wins.",
  "icon": "hub-icon.svg",
  "players": {
    "min": 2,
    "max": 4
  },
  "engine": "lockstep",
  "engineConfig": {
    "tickMs": 100,
    "delay": 2,
    "forfeit": false
  },
  "reconnectGraceMs": 30000,
  "minMatchMs": 30000,
  "ai": {
    "max": 3,
    "default": 1,
    "label": "AI armies",
    "levels": {
      "choices": [
        1,
        2,
        3,
        4
      ],
      "names": {
        "1": "Recruit",
        "2": "Veteran",
        "3": "Elite",
        "4": "Invincible"
      },
      "default": 2
    }
  },
  "options": [
    {
      "key": "map",
      "label": "Map",
      "type": "choice",
      "choices": [
        "plain",
        "lakes",
        "marsh",
        "canyons",
        "winter"
      ],
      "names": {
        "plain": "Plain",
        "lakes": "Lakes",
        "marsh": "Marsh",
        "canyons": "Canyons",
        "winter": "Winter"
      }
    },
    {
      "key": "pace",
      "label": "Game pace",
      "type": "choice",
      "choices": [
        25,
        50,
        100
      ],
      "names": {
        "25": "Quick",
        "50": "Medium",
        "100": "Slow"
      },
      "default": 100
    },
    {
      "key": "army",
      "label": "Army size",
      "type": "int",
      "min": 1,
      "max": 100,
      "default": 30
    },
    {
      "key": "aiArmy",
      "label": "AI army size (solo)",
      "type": "int",
      "min": 1,
      "max": 100,
      "default": 30
    },
    {
      "key": "crates",
      "label": "Crates",
      "type": "choice",
      "choices": [
        true,
        false
      ],
      "names": {
        "true": "On",
        "false": "Off"
      }
    },
    {
      "key": "allies",
      "label": "Alliances",
      "type": "bool",
      "default": false
    },
    {
      "key": "misTypes",
      "label": "Missions (none = off)",
      "type": "set",
      "choices": [
        "cargo",
        "escort",
        "hold",
        "rescue",
        "kill",
        "sabo"
      ],
      "names": {
        "cargo": "Cargo",
        "escort": "Escort",
        "hold": "Hold the hill",
        "rescue": "Rescue",
        "kill": "Assassinate",
        "sabo": "Sabotage"
      }
    },
    {
      "key": "disTypes",
      "label": "Disasters (none = off)",
      "type": "set",
      "choices": [
        "volcano",
        "flood",
        "beasts",
        "locusts",
        "quake",
        "tornado"
      ],
      "names": {
        "volcano": "Volcano",
        "flood": "Flood",
        "beasts": "Wild beasts",
        "locusts": "Locusts",
        "quake": "Earthquake",
        "tornado": "Tornado"
      },
      "default": []
    }
  ],
  "score": {
    "label": "Most kills",
    "order": "desc",
    "format": "int"
  }
}
